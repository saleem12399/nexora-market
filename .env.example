# NEXORA MARKET — environment variables (no values here; set them in Render)
# DATABASE_URL — Supabase Postgres connection string (URI mode). Collected
#   securely, never in chat, never in the repo.
# SUPABASE_URL — https://rbqigtowumasoopebtyc.supabase.co
# SUPABASE_PUBLISHABLE_KEY — the Supabase publishable key (sb_publishable_...,
#   public by design). Set as a Render env var at deploy time.
DATABASE_URL=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# PORT is set by Render; defaults to 3000 locally.
PORT=3000
