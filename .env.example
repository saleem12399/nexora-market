# NEXORA MARKET — environment variables (no values here; set them in Render
# or Vercel — never in chat, never in the repo)
# DATABASE_URL — Supabase Postgres connection string (URI mode, Session
#   pooler, port 5432). Collected securely, never in chat, never in the repo.
# SUPABASE_URL — https://rbqigtowumasoopebtyc.supabase.co
# SUPABASE_PUBLISHABLE_KEY — the Supabase publishable key (sb_publishable_...,
#   public by design). Set as a deploy env var, never in code.
# RUN_MIGRATIONS_ON_BOOT — "true" only on Vercel: the first request of a
#   cold start runs db:migrate + db:seed (guarded by a Postgres advisory
#   lock). Leave unset (off) on Render, where migrations run from the shell.
DATABASE_URL=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
RUN_MIGRATIONS_ON_BOOT=
# PORT is set by Render; defaults to 3000 locally. Vercel sets its own PORT.
PORT=3000
